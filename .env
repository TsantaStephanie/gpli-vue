# ─── GLPI API Configuration ───────────────────────────────────────────────────
# URL de base de GLPI (doit correspondre au vhost Apache)
VITE_GLPI_BASE_URL=http://localhost:5173/apirest.php

# App-Token : générer dans GLPI > Configuration > API (obligatoire)
VITE_GLPI_APP_TOKEN=YHY0tzxR3sS7mrhLA8ylXelYYAPcnrxYfrShVAtl

# User-Token : disponible dans GLPI > Mon compte > API token (optionnel si login/password)
VITE_GLPI_USER_TOKEN=

# Ou utiliser login / mot de passe (base64 automatique dans glpiClient.ts)
VITE_GLPI_LOGIN=glpi
VITE_GLPI_PASSWORD=glpi

# ─── Mode d'authentification : "token" | "credentials" ────────────────────────
VITE_GLPI_AUTH_MODE=credentials
 